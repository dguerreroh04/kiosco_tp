generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id                      Int                       @id @default(autoincrement())
  nombre                  String                    @unique
  precio_unidad           Decimal
  descripcion             String
  nacional                Boolean
  categoria               String
  imagen                  String                    @unique
  Productos_seleccionados Productos_seleccionados[]
}

model Productos_seleccionados {
  id           Int      @id @default(autoincrement())
  producto     Producto @relation(fields: [id_producto], references: [id], onDelete: Cascade)
  cantidad     Int
  id_producto  Int
  comprador    Usuario  @relation(fields: [id_comprador], references: [id], onDelete: Cascade)
  id_comprador Int
}

model Usuario {
  id                      Int                       @id @default(autoincrement())
  nombre                  String                    @unique
  contrasenia             String
  edad                    Int
  mail                    String                    @unique
  nro_tel                 Int
  dni                     Int                       @unique
  es_empleado             Boolean                   @default(false)
  Productos_seleccionados Productos_seleccionados[]
  Ticket                  Ticket[]
}

model Ticket {
  id            Int      @id @default(autoincrement())
  nombre_kiosco String
  Domicilio     String
  comprador     Usuario  @relation(fields: [id_comprador], references: [id], onDelete: Cascade)
  id_comprador  Int
  fecha_venta   DateTime @default(now()) @db.Timestamp(6)
  forma_pago    String
  total         Int
}
